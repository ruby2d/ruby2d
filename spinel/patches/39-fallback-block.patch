+/* Emit a conditional fallback block as one branch-scoped boxed expression.
+   The receiver-specific caller owns receiver/argument evaluation and decides
+   whether the branch is taken; this helper owns the Ruby block sequence:
+
+     bind yielded value -> leading statements -> tail prelude -> boxed tail
+
+   Tail emission may append allocation/rooting statements to g_pre. Capturing
+   that prelude here keeps it inside the missing-item/key branch instead of
+   eagerly running it before the delete call. The live-local check mirrors the
+   liveness containment used by iterator emitters: a parsed but pruned block
+   parameter has no lv_* declaration and needs no assignment. */
+static void emit_scoped_fallback_block(Compiler *c, int block,
+                                       TyKind yielded_type,
+                                       const char *yielded_expr, Buf *b) {
+  const NodeTable *nt = c->nt;
+  int body = nt_ref(nt, block, "body");
+  int bn = 0;
+  const int *bb = body >= 0 ? nt_arr(nt, body, "body", &bn) : NULL;
+  const char *p0 = block_param_name(c, block, 0);
+  Scope *bs = p0 ? comp_scope_of(c, block) : NULL;
+  LocalVar *plv = (bs && p0) ? scope_local(bs, p0) : NULL;
+  Buf inner; memset(&inner, 0, sizeof inner);
+  Buf value; memset(&value, 0, sizeof value);
+
+  if (plv) {
+    emit_local_ref(c, block, p0, &inner);
+    buf_puts(&inner, " = ");
+    if (plv->type == TY_POLY && yielded_type != TY_POLY &&
+        yielded_type != TY_UNKNOWN)
+      emit_boxed_text(c, yielded_type, yielded_expr, &inner);
+    else if (yielded_type == TY_POLY && plv->type != TY_POLY &&
+             plv->type != TY_UNKNOWN)
+      emit_unbox_text(c, plv->type, yielded_expr, &inner);
+    else
+      buf_puts(&inner, yielded_expr);
+    buf_puts(&inner, ";\n");
+  }
+
+  Buf *saved_pre = g_pre;
+  int saved_indent = g_indent;
+  g_pre = &inner;
+  g_indent = 0;
+  for (int i = 0; i + 1 < bn; i++) emit_stmt(c, bb[i], &inner, 0);
+  if (bn > 0) emit_boxed(c, bb[bn - 1], &value);
+  else buf_puts(&value, "sp_box_nil()");
+  g_pre = saved_pre;
+  g_indent = saved_indent;
+
+  buf_puts(b, "({\n");
+  if (inner.p) buf_puts(b, inner.p);
+  buf_puts(b, value.p ? value.p : "sp_box_nil()");
+  buf_puts(b, "; })");
+  free(inner.p);
+  free(value.p);
+}
