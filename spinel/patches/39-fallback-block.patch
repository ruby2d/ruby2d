diff --git a/test/delete_fallback_scope.rb b/test/delete_fallback_scope.rb
new file mode 100644
index 0000000..f8a308f
--- /dev/null
+++ b/test/delete_fallback_scope.rb
@@ -0,0 +1,63 @@
+# Conditional Array/Hash delete fallbacks must bind their yielded value, run
+# every body statement, and keep tail construction inside the missing branch.
+
+array_calls = 0
+p [1].delete(2) { |missing| array_calls += 1; [missing] }
+p array_calls
+
+p ["a"].delete("z") { |missing| { missing => missing.upcase } }
+p [1, "a"].delete(:missing) { |missing| [missing] }
+p([].delete(1) { |unused| :empty_array })
+p([1].delete(2) {})
+
+array_seen = []
+p [1].delete(1) { |missing| [array_seen << missing] }
+p array_seen
+
+events = []
+def delete_receiver(events)
+  events << :receiver
+  [1]
+end
+
+def delete_argument(events)
+  events << :argument
+  2
+end
+
+p delete_receiver(events).delete(delete_argument(events)) { |missing|
+  events << :block
+  missing
+}
+p events
+
+hash_calls = 0
+p({ a: 1 }.delete(:missing) { |key| hash_calls += 1; [key] })
+p hash_calls
+
+p({ "a" => 1 }.delete("missing") { |key| [key] })
+p({ 1 => "one" }.delete(2) { |key| [key] })
+p({ 1 => "one", "two" => 2 }.delete(:missing) { |key| [key] })
+p({}.delete(:missing) { |unused| :empty_hash })
+p({ a: 1 }.delete(:missing) {})
+
+hash_events = []
+def delete_hash_receiver(events)
+  events << :receiver
+  { a: 1 }
+end
+
+def delete_hash_key(events)
+  events << :key
+  :missing
+end
+
+p delete_hash_receiver(hash_events).delete(delete_hash_key(hash_events)) { |key|
+  hash_events << :block
+  key
+}
+p hash_events
+
+hash_seen = []
+p({ a: 1 }.delete(:a) { |key| [hash_seen << key] })
+p hash_seen
