diff --git a/test/array_reverse_each_mutation.rb b/test/array_reverse_each_mutation.rb
new file mode 100644
--- /dev/null
+++ b/test/array_reverse_each_mutation.rb
@@ -0,0 +1,61 @@
+# Array#reverse_each keeps its initial upper bound but skips pending indices
+# invalidated by receiver shrinkage. It returns the original receiver.
+
+a = [1, 2, 3]
+seen = []
+returned = a.reverse_each do |x|
+  seen << x
+  a.clear if x == 3
+end
+p [seen, a, returned.equal?(a)]
+
+a = [1, 2, 3, 4]
+seen = []
+returned = a.reverse_each do |x|
+  seen << x
+  if x == 4
+    a.pop
+    a.pop
+  end
+end
+p [seen, a, returned.equal?(a)]
+
+a = [1, 2, 3]
+seen = []
+returned = a.reverse_each do |x|
+  seen << x
+  a.pop if x == 3
+end
+p [seen, a, returned.equal?(a)]
+
+a = [1, 2, 3]
+seen = []
+returned = a.reverse_each do |x|
+  seen << x
+  a.shift if seen.length == 1
+end
+p [seen, a, returned.equal?(a)]
+
+a = [1, 2, 3]
+seen = []
+returned = a.reverse_each do |x|
+  seen << x
+  a << 4 if x == 3
+end
+p [seen, a, returned.equal?(a)]
+
+a = ["a", "b", "c"]
+seen = []
+returned = a.reverse_each do |x|
+  seen << x
+  a.clear if x == "c"
+end
+p [seen, a, returned.equal?(a)]
+
+a = [1, "two", 3.0]
+seen = []
+returned = a.reverse_each do |x|
+  seen << x
+  a.clear if x == 3.0
+end
+p [seen, a, returned.equal?(a)]
