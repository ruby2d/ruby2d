diff --git a/test/array_pruned_block_param.rb b/test/array_pruned_block_param.rb
new file mode 100644
--- /dev/null
+++ b/test/array_pruned_block_param.rb
@@ -0,0 +1,19 @@
+# An unused block parameter may be removed by liveness analysis. Array
+# emitters must not reference its absent C local.
+
+p([].map { |unused| 1 })
+result = [].each { |unused| true }; p result
+p([].select { |unused| true })
+p([].reject { |unused| false })
+p([].filter_map { |unused| 1 })
+p([].bsearch { |unused| true })
+p([].bsearch_index { |unused| true })
+p([].map { |used| used })
+p([].map { 1 })
+p([1].map { |unused| 7 })
+p([1].each { |unused| 7 })
+p([1].select { |unused| true })
+p([1].reject { |unused| false })
+p([1].filter_map { |unused| 7 })
+p([1, 2, 3].bsearch { |unused| true })
+p([1, 2, 3].bsearch_index { |unused| true })
