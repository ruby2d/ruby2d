# Tasks for the experimental Spinel AOT build path.
#
#   cd spinel && rake            # all three checks
#   cd spinel && rake demo       # or subset, issues
#
# Deliberately separate from the root Rakefile. Everything about this branch
# lives under spinel/ so it merges or disappears as one piece, without leaving
# branch-conditional lines in files the rest of the project shares. See
# README.md for what the checks actually do.

ROOT = File.expand_path('..', __dir__)

# The root Rakefile's banner style, minus its dependency on the assets
# submodule and the gem's colorize helpers — this file has to run on its own.
def print_task(title)
  print "\n", "  \e[38;5;196m◆\e[0m \e[1m#{title}\e[0m", "\n"
end

def run_check(name)
  print_task "Spinel: #{name}"
  puts "  \e[2m$ ruby spinel/tools/check.rb #{name}\e[0m\n\n"
  Dir.chdir(ROOT) { system('ruby', 'spinel/tools/check.rb', name) || exit(1) }
rescue Interrupt
  exit(130)
end

CHECKS = {
  'subset' => 'compile the lib/ slice and diff it against CRuby',
  'demo' => 'build the square demo and check it actually drew pixels',
  'cli' => 'build an app with `ruby2d build --spinel` and check its pixels',
  'input' => 'build an app that injects input into itself and check every handler fires',
  'preflight' => 'check an unsupported app is rejected by feature name',
  'issues' => 're-run every filed reproducer to see what upstream has fixed'
}.freeze

CHECKS.each do |name, description|
  desc "Spinel: #{description}"
  task(name) { run_check(name) }
end

desc 'Run all Spinel checks'
task(:all) { run_check('all') }

def run_tool(name, script, *args)
  args = args.compact
  print_task "Spinel: #{name}"
  puts "  \e[2m$ ruby spinel/tools/#{[script, *args].join(' ')}\e[0m"
  Dir.chdir(ROOT) { system('ruby', "spinel/tools/#{script}", *args) || exit(1) }
rescue Interrupt
  exit(130)
end

# These sit outside the default set: they answer roadmap questions rather than
# regression ones, and each takes minutes — except `coverage`, which is a source
# scan and needs no compiler at all.

desc 'Spinel: how much of examples/ and test/ this target accepts, and what to add next'
task(:coverage) { run_tool('coverage', 'coverage.rb') }

desc 'Spinel: what blocks a clean build of the whole library'
task(:survey) { run_tool('survey', 'survey.rb') }

desc 'Spinel: drop each workaround in turn and report which are still needed'
task(:sweep) { run_tool('sweep', 'sweep.rb') }

desc 'Spinel: build the fixture on both engines and diff the pixels'
task(:compare) { run_tool('compare', 'compare.rb') }

desc 'Spinel: build each example on both engines and check the scene still moves'
task :motion, [:name] do |_t, args|
  run_tool('motion', 'motion.rb', args[:name])
end

desc 'Spinel: compare Ruby-side frame cost across CRuby, mruby and Spinel — rake fps[name,frames]'
task :fps, [:name, :frames] do |_t, args|
  run_tool('fps', 'fps.rb', args[:name], args[:frames])
end

# `issues` before `sweep` deliberately: the reproducers are quick and tell you
# where to look, the sweep is slow and tells you what can actually go. They have
# disagreed in both directions, so neither substitutes for the other.
desc 'Spinel: pull and rebuild the compiler, then re-check issues and workarounds'
task upstream: [] do
  run_tool('upstream', 'upstream.rb')
  run_check('issues')
  run_tool('sweep', 'sweep.rb')
end

task default: :all
